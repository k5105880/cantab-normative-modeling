    "rti_cdf.R"
  ],
  "optional_cohort_file": "diagnosis_reference.csv",
  "priors": {
    "mean_coefficients": "normal(0, 0.20)",
    "participant_sd": "exponential(5)",
    "smooth_sd": "exponential(5)",
