    "cross_validation": {
      "folds": 5,
      "iterations_per_chain": 3000,
      "warmup_per_chain": 1000
    },
    "adapt_delta": 0.999,
    "max_treedepth": 20,
    "recovery": {
      "maximum_attempts": 2,
      "iteration_and_warmup_multiplier": 2,
      "adapt_delta": 0.99999,
      "seed_increment": 1
    },
    "seed": 20260921,
    "fit_seed_offset": 31000,
    "fold_seed_increment": 10,
    "convergence": {
      "maximum_rhat_exclusive": 1.01,
      "minimum_bulk_and_tail_ess": 400,
      "minimum_bfmi": 0.3,
      "allowed_divergences": 0,
      "allowed_max_treedepth_hits": 0
    },
    "precision": {
      "posterior_mcse_z_maximum": 0.03,
